import os
import shutil
import yaml

from curtin.commands.curthooks import builtin_curthooks
from curtin.config import load_command_config
from curtin.util import load_command_environment


DEFAULT_ROUTES = ('0.0.0.0/0', 'default', '::/0')


def _gateway(cfg):
    """IPv4 default gateway of a netplan interface (gateway4 or a default route)."""
    gw = cfg.get('gateway4') or cfg.get('gateway')
    if gw:
        return gw
    for route in cfg.get('routes', []) or []:
        if route.get('to') in ('0.0.0.0/0', 'default') and route.get('via'):
            return route['via']
    return None


def _extra_lines(cfg, skip_default_route):
    """mtu + static route lines shared by every stanza."""
    lines = []
    mtu = cfg.get('mtu')
    if mtu and int(mtu) != 1500:
        lines.append(f"    mtu {mtu}\n")
    for route in cfg.get('routes', []) or []:
        to, via, metric = route.get('to'), route.get('via'), route.get('metric')
        if not (to and via):
            continue
        if skip_default_route and to in DEFAULT_ROUTES:
            continue  # rendered as "gateway"
        cmd = f"    up ip route add {to} via {via}"
        if metric:
            cmd += f" metric {metric}"
        lines.append(cmd + "\n")
        print(f"DEBUG: Added static route: {to} via {via}")
    return lines


def configure_proxmox_network(config, target):
    """Convert MAAS netplan config to Proxmox /etc/network/interfaces.

    Every interface MAAS defines is rendered (ethernets, bonds, VLANs, MAAS
    bridges), keeping bond parameters and MTUs. The vmbr0 bridge is put on the
    interface that carries the default gateway (falling back to the first
    interface with an address, in bridge > VLAN > bond > ethernet order). Any
    other addresses stay as static addresses on their own interfaces, so a
    management IP on a bond and a storage IP on a VLAN both survive.
    """
    print("=" * 80)
    print("CURTIN-HOOKS: Converting netplan to Proxmox network configuration...")
    print("=" * 80)

    network_config = config.get('network', {})

    print(f"DEBUG: Full network config received from MAAS:")
    print(yaml.dump(network_config, default_flow_style=False, indent=2))
    print("-" * 80)

    if not network_config:
        print("WARNING: No network config found in curtin config")
        return

    network = network_config.get('config', network_config)
    if isinstance(network, str):
        network = yaml.safe_load(network)
    if 'network' in network:
        network = network['network']

    ethernets = network.get('ethernets', {}) or {}
    bonds = network.get('bonds', {}) or {}
    vlans = network.get('vlans', {}) or {}
    bridges = network.get('bridges', {}) or {}

    # Pick the interface that becomes vmbr0's port (the "primary")
    candidates = []  # (kind, name, cfg) in bridge > vlan > bond > ethernet order
    for kind, group in (('bridge', bridges), ('vlan', vlans),
                        ('bond', bonds), ('ethernet', ethernets)):
        for name, cfg in group.items():
            if cfg.get('addresses'):
                candidates.append((kind, name, cfg))
    if not candidates:
        print("WARNING: No interface with IP address found in netplan config")
        return
    with_gw = [c for c in candidates if _gateway(c[2])]
    primary_kind, primary_name, primary_cfg = (with_gw or candidates)[0]
    if len(with_gw) > 1:
        print(f"WARNING: {len(with_gw)} interfaces have a default gateway; "
              f"using {primary_name}, the others keep their address without a gateway")

    gateway = _gateway(primary_cfg)
    dns_servers = (primary_cfg.get('nameservers', {}) or {}).get('addresses', ['8.8.8.8', '8.8.4.4'])
    if primary_kind == 'bridge':
        # MAAS created a bridge: vmbr0 replaces it, with the same ports
        bridge_ports = primary_cfg.get('interfaces', []) or []
    else:
        bridge_ports = [primary_name]

    print(f"DEBUG: Configuring bridge vmbr0 on {' '.join(bridge_ports)} ({primary_kind} {primary_name})")
    print(f"  - Addresses: {primary_cfg.get('addresses')}")
    print(f"  - Gateway: {gateway}")
    print(f"  - DNS Servers: {dns_servers}")

    def stanza(name, cfg, extra):
        """One interface. Primary (and MAAS bridges) stay manual: vmbr0 has the IP."""
        out = [f"auto {name}\n"]
        has_ip = bool(cfg.get('addresses')) and name != primary_name and name not in bridges
        out.append(f"iface {name} inet {'static' if has_ip else 'manual'}\n")
        if has_ip:
            for addr in cfg['addresses']:
                out.append(f"    address {addr}\n")
            print(f"DEBUG: {name} keeps its own address(es): {cfg['addresses']}")
        out.extend(extra)
        out.extend(_extra_lines(cfg, skip_default_route=True) if has_ip
                   else _extra_lines({'mtu': cfg.get('mtu')}, skip_default_route=False))
        out.append("\n")
        return out

    content = [
        "# network interface settings; autogenerated by curtin\n",
        "# Converted from netplan for Proxmox VE compatibility\n",
        "\n",
        "auto lo\n",
        "iface lo inet loopback\n",
        "\n",
    ]

    for name, cfg in ethernets.items():
        content += stanza(name, cfg, [])

    for name, cfg in bonds.items():
        params = cfg.get('parameters', {}) or {}
        mode = params.get('mode', '802.3ad')
        extra = [
            f"    bond-slaves {' '.join(cfg.get('interfaces', []) or []) or 'none'}\n",
            f"    bond-mode {mode}\n",
            f"    bond-miimon {params.get('mii-monitor-interval', 100)}\n",
        ]
        if mode == '802.3ad':
            extra.append(f"    bond-lacp-rate {params.get('lacp-rate', 'fast')}\n")
        if mode in ('802.3ad', 'balance-xor', 'balance-tlb', 'balance-alb'):
            extra.append(f"    bond-xmit-hash-policy {params.get('transmit-hash-policy', 'layer2+3')}\n")
        if params.get('up-delay'):
            extra.append(f"    bond-updelay {params['up-delay']}\n")
        if params.get('down-delay'):
            extra.append(f"    bond-downdelay {params['down-delay']}\n")
        print(f"DEBUG: Bond {name}: slaves={cfg.get('interfaces')} mode={mode}")
        content += stanza(name, cfg, extra)

    for name, cfg in vlans.items():
        extra = [
            f"    vlan-raw-device {cfg.get('link')}\n",
            f"    vlan-id {cfg.get('id')}\n",
        ]
        print(f"DEBUG: VLAN {name}: id={cfg.get('id')} link={cfg.get('link')}")
        content += stanza(name, cfg, extra)

    # vmbr0 (replaces any MAAS bridge, so those are not rendered separately)
    content.append("auto vmbr0\n")
    content.append("iface vmbr0 inet static\n")
    for addr in primary_cfg['addresses']:
        content.append(f"    address {addr}\n")
    if gateway:
        content.append(f"    gateway {gateway}\n")
    content.append(f"    bridge-ports {' '.join(bridge_ports)}\n")
    content.append("    bridge-stp off\n")
    content.append("    bridge-fd 0\n")
    content.extend(_extra_lines(primary_cfg, skip_default_route=True))
    content.append("\n")
    content.append("source /etc/network/interfaces.d/*\n")

    interfaces_path = os.path.join(target, "etc/network/interfaces")
    with open(interfaces_path, 'w') as f:
        f.writelines(content)

    print(f"DEBUG: Created {interfaces_path} with contents:")
    print("-" * 80)
    print(''.join(content))
    print("-" * 80)

    # Write DNS servers directly to /etc/resolv.conf
    # Proxmox web UI manages /etc/resolv.conf directly, not via dns-nameservers in /etc/network/interfaces
    if dns_servers:
        resolv_conf_path = os.path.join(target, "etc/resolv.conf")
        resolv_content = []
        resolv_content.append("# DNS servers from MAAS deployment\n")
        resolv_content.append("# Can be changed via Proxmox web UI: Node → System → DNS\n")
        for dns_server in dns_servers:
            resolv_content.append(f"nameserver {dns_server}\n")

        with open(resolv_conf_path, 'w') as f:
            f.writelines(resolv_content)

        print(f"DEBUG: Created {resolv_conf_path} with DNS servers: {', '.join(dns_servers)}")

    # CRITICAL: Delete /etc/network/interfaces.new if it exists
    # Proxmox's pvenetcommit.service copies .new -> interfaces on first boot
    # The .new file may contain wrong interface names (ens4) from the image build
    interfaces_new_path = os.path.join(target, "etc/network/interfaces.new")
    if os.path.exists(interfaces_new_path):
        os.remove(interfaces_new_path)
        print(f"DEBUG: Removed {interfaces_new_path} to prevent Proxmox from overwriting our config on first boot")

    configured = True

    if not configured:
        print("WARNING: No interface with IP address found in netplan config")
        return

    # Disable cloud-init network management
    cloud_cfg_dir = os.path.join(target, "etc/cloud/cloud.cfg.d")
    os.makedirs(cloud_cfg_dir, exist_ok=True)

    cloud_cfg_path = os.path.join(cloud_cfg_dir, "99-disable-network-config.cfg")
    with open(cloud_cfg_path, 'w') as f:
        f.write("network: {config: disabled}\n")

    print(f"Created {cloud_cfg_path} to disable cloud-init network management")
    print("Proxmox network configuration complete")


def cleanup():
    """Remove curtin-hooks so its as if we were never here."""
    curtin_dir = os.path.dirname(__file__)
    shutil.rmtree(curtin_dir)


def main():
    state = load_command_environment()
    config = load_command_config(None, state)
    target = state['target']

    print("=" * 80)
    print("CURTIN-HOOKS: Starting custom Proxmox deployment hooks")
    print("=" * 80)
    print(f"DEBUG: Target directory: {target}")
    print(f"DEBUG: Hostname from config: {config.get('hostname', 'NOT SET')}")
    print(f"DEBUG: System UUID from config: {config.get('system_serial', 'NOT SET')}")
    print("-" * 80)

    # Configure Proxmox network with /etc/network/interfaces
    configure_proxmox_network(config, target)

    # Remove network config before passing to builtin_curthooks
    # This prevents builtin_curthooks from writing cloud-init netplan files
    # that would conflict with our /etc/network/interfaces configuration
    config_without_network = config.copy()
    if 'network' in config_without_network:
        del config_without_network['network']
        print("DEBUG: Removed network config from builtin_curthooks to prevent cloud-init conflict")

    # Skip kernel installation - Proxmox kernel is already installed in the image
    # Workaround for Debian 13: Create legacy /etc/apt/sources.list from DEB822 format
    # This prevents curtin from crashing when it tries to read sources.list
    sources_list_path = os.path.join(target, "etc/apt/sources.list")
    if not os.path.exists(sources_list_path):
        print("DEBUG: Creating /etc/apt/sources.list from DEB822 format for curtin compatibility")
        # Create a minimal sources.list that points to Debian and Proxmox repos
        with open(sources_list_path, 'w') as f:
            f.write("# Auto-generated for curtin compatibility\n")
            f.write("deb http://deb.debian.org/debian trixie main contrib non-free non-free-firmware\n")
            f.write("deb http://deb.debian.org/debian trixie-updates main contrib non-free non-free-firmware\n")
            f.write("deb http://security.debian.org/debian-security trixie-security main contrib non-free non-free-firmware\n")
            # Proxmox repos are already in sources.list.d/proxmox.list (signed-by);
            # repeating them here only makes apt warn "configured multiple times".

    # FIX issue #9: Prevent builtin_curthooks from overwriting sources.list
    # with Ubuntu repos (caused by Ubuntu cloud-init package detection)
    if 'apt' not in config_without_network:
        config_without_network['apt'] = {}
    config_without_network['apt']['preserve_sources_list'] = True
    config_without_network['apt']['sources'] = {}
    config_without_network['apt']['sources_list'] = {}
    print("DEBUG: Set preserve_sources_list=True to prevent Ubuntu repo injection")

    # CRITICAL FIX: Use {'install': False} to disable kernel installation
    # Setting kernel=None causes AttributeError in curtin's install_kernel() at line 377
    # According to curtin source, install_kernel() checks for kernel: {install: false}
    config_without_network['kernel'] = {'install': False}
    print("=" * 80)
    print("DEBUG: Disabled kernel installation by setting kernel={'install': False}")
    print("DEBUG: Proxmox kernel 6.17.4-2-pve is already installed in the image")
    print("=" * 80)

    # FIX: Prevent grub-install from failing on RAID (EFI on md device)
    # grub-install cannot register EFI boot entries when the ESP is on an md device
    # because EFI firmware doesn't understand md device paths. Setting update_nvram=False
    # adds --no-nvram to grub-install, skipping NVRAM registration.
    # Only disable NVRAM on RAID — on single disk, let grub create proper boot entries.
    if 'grub' not in config_without_network:
        config_without_network['grub'] = {}

    # Detect if ESP is on a RAID device
    esp_on_raid = False
    efi_mount = os.path.join(target, "boot/efi")
    if os.path.ismount(efi_mount):
        try:
            import subprocess
            result = subprocess.run(
                ['findmnt', '-n', '-o', 'SOURCE', efi_mount],
                capture_output=True, text=True
            )
            esp_device = result.stdout.strip()
            if '/md' in esp_device:
                esp_on_raid = True
                print(f"DEBUG: ESP is on RAID device {esp_device}, disabling NVRAM update")
            else:
                print(f"DEBUG: ESP is on physical device {esp_device}, allowing NVRAM update")
        except Exception as e:
            print(f"DEBUG: Could not detect ESP device ({e}), allowing NVRAM update")
    else:
        print(f"DEBUG: {efi_mount} is not mounted yet, allowing NVRAM update")

    if esp_on_raid:
        config_without_network['grub']['update_nvram'] = False
        print("DEBUG: Set grub update_nvram=False (ESP on RAID, MAAS handles boot order via BMC)")
    else:
        print("DEBUG: Allowing grub to update NVRAM (ESP on physical device)")

    print("DEBUG: Config being passed to builtin_curthooks:")
    print(f"  - hostname: {config_without_network.get('hostname', 'NOT SET')}")
    print(f"  - kernel: {config_without_network.get('kernel', 'NOT SET')}")
    print(f"  - network: {config_without_network.get('network', 'REMOVED')}")
    print("-" * 80)

    # Run builtin curthooks for everything else (hostname, users, SSH keys, etc.)
    print("DEBUG: Calling builtin_curthooks()...")
    builtin_curthooks(config_without_network, target, state)
    print("DEBUG: builtin_curthooks() completed successfully")

    # Ensure fallback EFI boot path exists
    # grub-install puts files in EFI/debian/ but some firmware (especially on RAID)
    # only checks the fallback path EFI/BOOT/BOOTX64.EFI
    efi_debian_dir = os.path.join(target, "boot/efi/EFI/debian")
    efi_boot_dir = os.path.join(target, "boot/efi/EFI/BOOT")
    if os.path.isdir(efi_debian_dir):
        os.makedirs(efi_boot_dir, exist_ok=True)
        # Prefer shimx64.efi for secure boot, fall back to grubx64.efi
        shim_src = os.path.join(efi_debian_dir, "shimx64.efi")
        grub_src = os.path.join(efi_debian_dir, "grubx64.efi")
        boot_src = shim_src if os.path.exists(shim_src) else grub_src
        if os.path.exists(boot_src):
            grub_dst = os.path.join(efi_boot_dir, "BOOTX64.EFI")
            shutil.copy2(boot_src, grub_dst)
            print(f"DEBUG: Copied {os.path.basename(boot_src)} to fallback EFI path: {grub_dst}")
        # Also copy grubx64.efi to BOOT dir (shim needs it alongside)
        if os.path.exists(shim_src) and os.path.exists(grub_src):
            grub_boot_dst = os.path.join(efi_boot_dir, "grubx64.efi")
            shutil.copy2(grub_src, grub_boot_dst)
            print(f"DEBUG: Copied grubx64.efi to fallback EFI dir: {grub_boot_dst}")

    # Verify what was actually written
    hostname_path = os.path.join(target, "etc/hostname")
    if os.path.exists(hostname_path):
        with open(hostname_path, 'r') as f:
            actual_hostname = f.read().strip()
        print(f"DEBUG: Actual hostname written to /etc/hostname: {actual_hostname}")
    else:
        print("WARNING: /etc/hostname does not exist after builtin_curthooks!")
        print("DEBUG: MAAS should have set the hostname, checking if issue is in builtin_curthooks")

    interfaces_path = os.path.join(target, "etc/network/interfaces")
    if os.path.exists(interfaces_path):
        with open(interfaces_path, 'r') as f:
            actual_interfaces = f.read()
        print("DEBUG: Final /etc/network/interfaces content:")
        print("-" * 80)
        print(actual_interfaces)
        print("-" * 80)

    print("=" * 80)
    print("CURTIN-HOOKS: Completed successfully, cleaning up...")
    print("=" * 80)
    cleanup()


if __name__ == "__main__":
    main()
